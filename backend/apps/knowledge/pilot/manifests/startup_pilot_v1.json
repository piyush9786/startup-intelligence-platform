            "expected_title": "Startup India Seed Fund Scheme (SISFS)",
            "canonical_title": "Startup India Seed Fund Scheme (SISFS)",
            "classification": "canonical",
            "curation": {
                "canonical_summary": "The Startup India Seed Fund Scheme provides early-stage financial assistance to eligible startups for proof of concept, prototype development, product trials, market entry, commercialisation, and scaling.",
                "canonical_objective": "Provide seed-stage financial assistance so eligible startups can validate products, enter markets, commercialise, scale, and progress toward investment or institutional finance.",
                "canonical_eligibility_text": "Eligible applicants are DPIIT-recognised startups incorporated not more than two years before applying. The startup must have a scalable technology-led product, service, or business model and must not have received more than INR 10 lakh of monetary support under another Central or State Government scheme.",
                "official_url": "https://seedfund.startupindia.gov.in/",
                "application_url": "https://seedfund.startupindia.gov.in/",
                "canonical_support_types": [
                    "grant",
                    "investment",
                    "convertible_instrument",
                    "debt"
                ],
                "canonical_categories": [
                    "seed_funding"
                ],
                "canonical_benefits": [
                    {
                        "type": "grant",
                        "description": "Up to INR 20 lakh for proof-of-concept validation, prototype development, or product trials.",
                        "amount_min": null,
                        "amount_max": "2000000.00",
                        "currency": "INR"
                    },
                    {
                        "type": "investment",
                        "description": "Up to INR 50 lakh for market entry, commercialisation, or scaling through convertible debentures, debt, or debt-linked instruments.",
                        "amount_min": null,
                        "amount_max": "5000000.00",
                        "currency": "INR"
                    }
                ],
                "canonical_required_documents": [],
                "canonical_application_steps": [
                    {
                        "step_number": 1,
                        "instruction": "Visit the Startup India Seed Fund portal to review the current application status and submit an application when applications are open.",
