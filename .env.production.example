# Production Environment Configuration
# Copy this file to .env.production and fill in secure values before deploying.
# All CHANGE_THIS values MUST be replaced with real secrets before going live.

# ---------------------------------------------------------------------------
# Django Security
# ---------------------------------------------------------------------------
DEBUG=False
DJANGO_SECRET_KEY=CHANGE_THIS_TO_A_50_CHARACTER_RANDOM_SECRET_KEY_IN_PRODUCTION
DJANGO_ALLOWED_HOSTS=platform.startupintelligence.gov.in,127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.settings.production

# CORS: origins that the browser is allowed to talk to the API from
DJANGO_CORS_ALLOWED_ORIGINS=https://platform.startupintelligence.gov.in

# CSRF: must include the full TLS origin as seen by Django (set separately from CORS)
DJANGO_CSRF_TRUSTED_ORIGINS=https://platform.startupintelligence.gov.in

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=startup_intelligence_prod
POSTGRES_USER=sip_prod_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_POSTGRES_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis & Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ---------------------------------------------------------------------------
# Vector Search (Qdrant)
# ---------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
# Set to a strong random string if Qdrant is configured with authentication
QDRANT_API_KEY=
STARTUP_ADVISOR_QDRANT_PROFILE_FIELD=startup_profile_id
STARTUP_ADVISOR_RAG_ENABLED=false
STARTUP_ADVISOR_QDRANT_COLLECTION=startup_document_chunks_v1
STARTUP_ADVISOR_QDRANT_TIMEOUT_SECONDS=15
STARTUP_ADVISOR_RAG_TOP_K=3
STARTUP_ADVISOR_RAG_MIN_SCORE=0.35
STARTUP_ADVISOR_RAG_MAX_PROMPT_DOCUMENTS=3
STARTUP_ADVISOR_RAG_MAX_CHARS_PER_CHUNK=800
STARTUP_ADVISOR_RAG_MAX_TOTAL_CHARS=2400
RESEARCH_VECTOR_RAG_ENABLED=false
RESEARCH_VECTOR_QDRANT_COLLECTION=startup_founder_document_chunks_v1
RESEARCH_VECTOR_QDRANT_PROFILE_FIELD=startup_profile_id
RESEARCH_VECTOR_RAG_TOP_K=6
RESEARCH_VECTOR_RAG_MIN_SCORE=0.35

# ---------------------------------------------------------------------------
# Graph Database (Neo4j)
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_THIS_NEO4J_PASSWORD

# ---------------------------------------------------------------------------
# Object Storage (MinIO)
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=CHANGE_THIS_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_THIS_MINIO_SECRET_KEY
MINIO_BUCKET_RAW=startup-raw
MINIO_BUCKET_STARTUP_EVIDENCE=startup-eligibility-evidence
MINIO_BUCKET_PROCESSED=startup-processed-documents
ELIGIBILITY_EVIDENCE_MAX_BYTES=10485760
COMPANY_IMPORT_MAX_BYTES=104857600
COMPANY_IMPORT_MAX_ROWS=250000

# ---------------------------------------------------------------------------
# Transactional Email (SMTP)
# Replace Mailpit with a real provider (SES, SendGrid, Postmark, etc.)
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_THIS_SMTP_USERNAME
EMAIL_HOST_PASSWORD=CHANGE_THIS_SMTP_PASSWORD
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@startupintelligence.gov.in

# ---------------------------------------------------------------------------
# LLM / Embedding (Ollama)
# Models are downloaded automatically by the ollama_init service.
# GPU support: run:
# docker compose -f docker-compose.prod.yml -f docker-compose.gpu.yml up -d
# ---------------------------------------------------------------------------
STARTUP_ADVISOR_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
STARTUP_ADVISOR_LLM_MODEL=qwen3:4b
CHATBOT_LLM_MODEL=qwen3:4b
STARTUP_ADVISOR_EMBEDDING_MODEL=embeddinggemma
STARTUP_ADVISOR_EMBEDDING_TIMEOUT_SECONDS=30
STARTUP_ADVISOR_LLM_TIMEOUT_SECONDS=420
STARTUP_ADVISOR_LLM_TEMPERATURE=0.30
STARTUP_ADVISOR_LLM_MAX_OUTPUT_TOKENS=1536
AUTO_RESEARCH_AFTER_ADVISOR_ENABLED=true
STARTUP_ADVISOR_LLM_KEEP_ALIVE=5m
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# Public authentication abuse controls
AUTH_LOGIN_RATE=10/minute
AUTH_REFRESH_RATE=30/minute
AUTH_LOGOUT_RATE=30/minute
AUTH_REGISTER_RATE=5/hour
RESEARCH_HOURLY_RATE=5/hour
RESEARCH_DAILY_RATE=20/day

# Research orchestration reliability
RESEARCH_TASK_SOFT_TIME_LIMIT_SECONDS=540
RESEARCH_TASK_TIME_LIMIT_SECONDS=570
RESEARCH_JOB_QUEUE_TIMEOUT_SECONDS=900
RESEARCH_JOB_RUNNING_TIMEOUT_SECONDS=660
RESEARCH_STALE_RECOVERY_BATCH_SIZE=100

# Hybrid research search provider and cost/freshness controls
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
WEB_SEARCH_MAX_RESULTS=8
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_SEARCH_CACHE_SECONDS=21600
WEB_SEARCH_DEPTH=basic
WEB_SEARCH_TIME_RANGE=year
WEB_SEARCH_START_DATE=
WEB_SEARCH_END_DATE=

# ---------------------------------------------------------------------------
# ML Model Storage
# ---------------------------------------------------------------------------
ML_MODELS_DIR=/app/ml_models

# ---------------------------------------------------------------------------
# TLS / Proxy (external)
# The stack exposes Nginx on port 80. A TLS-terminating load balancer
# (e.g. AWS ALB, Cloudflare, Nginx upstream) MUST sit in front and forward
# X-Forwarded-Proto: https to Nginx.  Django SECURE_PROXY_SSL_HEADER reads
# that header to enforce HTTPS.
# ---------------------------------------------------------------------------
