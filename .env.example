COMPOSE_PROJECT_NAME=startup_intelligence
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
POSTGRES_DB=startup_intelligence
POSTGRES_USER=startup
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
QDRANT_URL=http://qdrant:6333
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false
MINIO_BUCKET_RAW=startup-raw-documents
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=noreply@startup.local
VITE_API_BASE_URL=http://localhost:8000/api/v1
COLLECTOR_USER_AGENT=StartupIntelligenceCollector/0.1 (+http://localhost:5173)
COLLECTOR_MAX_REDIRECTS=5
DOCUMENT_EXTRACTOR_VERSION=v1
DOCUMENT_CHUNK_MAX_CHARS=1800
DOCUMENT_CHUNK_OVERLAP_CHARS=250
DOCUMENT_MAX_CHUNKS=2000
MINIO_BUCKET_PROCESSED=startup-processed-documents
