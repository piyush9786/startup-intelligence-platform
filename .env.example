COMPOSE_PROJECT_NAME=startup_intelligence
LOCAL_UID=1000
LOCAL_GID=1000
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_DB=startup_intelligence
POSTGRES_USER=startup
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
STARTUP_ADVISOR_QDRANT_PROFILE_FIELD=startup_profile_id
STARTUP_ADVISOR_RAG_ENABLED=false
STARTUP_ADVISOR_QDRANT_COLLECTION=startup_document_chunks_v1
STARTUP_ADVISOR_QDRANT_TIMEOUT_SECONDS=15
STARTUP_ADVISOR_EMBEDDING_MODEL=embeddinggemma
STARTUP_ADVISOR_EMBEDDING_VERSION=ollama-embedding-v1
STARTUP_ADVISOR_EMBEDDING_TIMEOUT_SECONDS=30
STARTUP_ADVISOR_EMBEDDING_BATCH_SIZE=32
STARTUP_ADVISOR_EMBEDDING_KEEP_ALIVE=5m
STARTUP_ADVISOR_RAG_TOP_K=3
STARTUP_ADVISOR_RAG_MIN_SCORE=0.35
STARTUP_ADVISOR_RAG_MAX_PROMPT_DOCUMENTS=3
STARTUP_ADVISOR_RAG_MAX_CHARS_PER_CHUNK=800
STARTUP_ADVISOR_RAG_MAX_TOTAL_CHARS=2400
RESEARCH_VECTOR_RAG_ENABLED=false
RESEARCH_VECTOR_QDRANT_COLLECTION=startup_founder_document_chunks_v1
RESEARCH_VECTOR_QDRANT_PROFILE_FIELD=startup_profile_id
RESEARCH_VECTOR_RAG_TOP_K=6
RESEARCH_VECTOR_RAG_MIN_SCORE=0.35
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false
MINIO_BUCKET_RAW=startup-raw-documents
MINIO_BUCKET_STARTUP_EVIDENCE=startup-eligibility-evidence
ELIGIBILITY_EVIDENCE_MAX_BYTES=10485760
COMPANY_IMPORT_MAX_BYTES=104857600
COMPANY_IMPORT_MAX_ROWS=250000
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=noreply@startup.local
VITE_API_BASE_URL=/api/v1
VITE_PLATFORM_BASE_URL=/
VITE_DEV_PROXY_TARGET=http://localhost:8000
COLLECTOR_USER_AGENT=StartupIntelligenceCollector/0.1 (+http://localhost:5173)
COLLECTOR_MAX_REDIRECTS=5
DOCUMENT_EXTRACTOR_VERSION=v2
DOCUMENT_CHUNK_MAX_CHARS=1800
DOCUMENT_CHUNK_OVERLAP_CHARS=250
DOCUMENT_MAX_CHUNKS=2000
MINIO_BUCKET_PROCESSED=startup-processed-documents
DISCOVERY_ASSESSOR_VERSION=v1
DISCOVERY_MAX_DEPTH=3
DISCOVERY_MAX_LINKS_PER_DOCUMENT=500
DISCOVERY_MAX_PAGES_PER_SOURCE=250
DISCOVERY_REQUEST_DELAY_SECONDS=1.5
DISCOVERY_MIN_RAG_SCORE=45
DISCOVERY_MIN_STRUCTURED_SCORE=60
KNOWLEDGE_EXTRACTOR_VERSION=v4
KNOWLEDGE_MIN_CANDIDATE_SCORE=4
KNOWLEDGE_MAX_BLOCK_CHARS=30000

STARTUP_ADVISOR_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
STARTUP_ADVISOR_LLM_MODEL=qwen3:4b
CHATBOT_LLM_MODEL=qwen3:4b

OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

STARTUP_ADVISOR_LLM_TIMEOUT_SECONDS=420
STARTUP_ADVISOR_LLM_TEMPERATURE=0.3
STARTUP_ADVISOR_LLM_MAX_OUTPUT_TOKENS=1536
AUTO_RESEARCH_AFTER_ADVISOR_ENABLED=true
AUTO_RESEARCH_HANDOFF_RECONCILE_BATCH_SIZE=50
BOOTSTRAP_BUNDLED_CATALOGS_ON_START=true
STARTUP_ADVISOR_LLM_KEEP_ALIVE=10m

CHATBOT_LLM_ENABLED=true
CHATBOT_LLM_TIMEOUT_SECONDS=180
CHATBOT_LLM_MAX_OUTPUT_TOKENS=512
CHATBOT_LLM_HISTORY_TURNS=6
CHATBOT_LLM_KEEP_ALIVE=10m

CELERY_WORKER_CONCURRENCY=1
ASSISTANT_CHATBOT_TURN_RATE=20/hour

# Research orchestration reliability
RESEARCH_TASK_SOFT_TIME_LIMIT_SECONDS=540
RESEARCH_TASK_TIME_LIMIT_SECONDS=570
RESEARCH_JOB_QUEUE_TIMEOUT_SECONDS=900
RESEARCH_JOB_RUNNING_TIMEOUT_SECONDS=660
RESEARCH_STALE_RECOVERY_BATCH_SIZE=100

# Web Search & Hybrid Research API settings
WEB_SEARCH_ENABLED=false
RESEARCH_RAG_ENABLED=true
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
WEB_SEARCH_MAX_RESULTS=8
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_SEARCH_CACHE_SECONDS=21600
WEB_SEARCH_DEPTH=basic
WEB_SEARCH_TIME_RANGE=year
WEB_SEARCH_START_DATE=
WEB_SEARCH_END_DATE=

AUTH_LOGIN_RATE=10/minute
AUTH_REFRESH_RATE=30/minute
AUTH_LOGOUT_RATE=30/minute
AUTH_REGISTER_RATE=5/hour
RESEARCH_HOURLY_RATE=5/hour
RESEARCH_DAILY_RATE=20/day
